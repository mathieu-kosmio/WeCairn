  {
    "id": "weretexfeed0001",
    "name": "retex_feed",
    "type": "view",
    "system": false,
    "viewQuery": "SELECT r.id, r.organisation, r.author, u.name AS author_name,\n  r.title, r.situation, r.learning, r.recommendation, r.tags, r.source, r.source_ref, r.created, r.updated,\n  (SELECT COUNT(*) FROM votes v WHERE v.retex = r.id) AS vote_count,\n  (SELECT COUNT(*) FROM comments c WHERE c.retex = r.id) AS comment_count\nFROM retex r JOIN users u ON u.id = r.author",
    "listRule": "organisation = @request.auth.organisation",
    "viewRule": "organisation = @request.auth.organisation"
  },
  {
    "id": "weretexlead0001",
    "name": "leaderboard",
    "type": "view",
    "system": false,
    "viewQuery": "SELECT u.id, u.organisation, u.name,\n  (SELECT COUNT(*) FROM retex r WHERE r.author = u.id) AS retex_count,\n  (SELECT COUNT(*) FROM votes v JOIN retex r ON r.id = v.retex WHERE r.author = u.id) AS votes_received,\n  (SELECT COUNT(*) FROM votes v WHERE v.user = u.id) AS votes_given,\n  (SELECT COUNT(*) FROM comments c WHERE c.author = u.id) AS comments_count,\n  (10 * (SELECT COUNT(*) FROM retex r WHERE r.author = u.id)\n   + 2 * (SELECT COUNT(*) FROM votes v JOIN retex r ON r.id = v.retex WHERE r.author = u.id)\n   + 1 * (SELECT COUNT(*) FROM votes v WHERE v.user = u.id)\n   + 3 * (SELECT COUNT(*) FROM comments c WHERE c.author = u.id)) AS points\nFROM users u",
    "listRule": "organisation = @request.auth.organisation",
    "viewRule": "organisation = @request.auth.organisation"
  }
